{
  "name": "one2oneight-storefront",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "postinstall": "node scripts/copy-swagger.mjs",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "nodemailer": "^10.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "swagger-ui-dist": "^5.34.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
