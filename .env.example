# ─────────────────────────────────────────────────────────────────────────────
# ONE 2 1 EIGHT — environment variables (PLACEHOLDERS ONLY)
#
# Copy to `.env.local` for local work. NEVER commit real values.
# On Vercel set them under Project → Settings → Environment Variables.
# All variables below are read on the SERVER only; nothing here is exposed to browsers.
# The app validates them at start-up (lib/env.ts) and refuses unsafe combinations.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production
# If omitted: `production` for production builds, `development` otherwise (safe default).
# Only `production` is indexable by search engines; staging/dev send noindex + Disallow: /.
APP_ENV=development

# live  → talk to the real backend at API_BASE_URL (REQUIRED for staging/production)
# mock  → in-memory development/test API. Refused unless APP_ENV is development or test.
API_MODE=live

# Backend REST API root (see openapi/openapi.yaml). Must be https:// in production.
# Browsers never see this URL – they call the same-origin proxy at /api/v1/*.
API_BASE_URL=https://REPLACE_WITH_BACKEND_HOST/v1

# Public origin of this site – used for canonical URLs, sitemap, Open Graph and JSON-LD.
# Required for staging/production; must be https and must not be a placeholder in production.
NEXT_PUBLIC_SITE_URL=https://REPLACE_WITH_PRODUCTION_DOMAIN

# Per-request timeout for backend calls (ms, 500–60000).
API_TIMEOUT_MS=8000

# Name of the admin session cookie set by the backend (used by the /admin edge gate).
ADMIN_SESSION_COOKIE=o218_admin_session

# Shared secret the backend sends to POST /api/revalidate after catalogue/content changes
# (min 24 chars, e.g. `openssl rand -hex 32`). Leave empty to disable the endpoint.
REVALIDATE_SECRET=

# ── Content-Security-Policy additions (space-separated origins) ──────────────
# Needed when you integrate a payment SDK, analytics, etc. Example for a hosted checkout:
#   CSP_EXTRA_SCRIPT_SRC=https://checkout.your-gateway.invalid
#   CSP_EXTRA_FRAME_SRC=https://api.your-gateway.invalid
#   CSP_EXTRA_CONNECT_SRC=https://api.your-gateway.invalid
# Read at BUILD time (next.config.ts) – redeploy after changing.
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_CONNECT_SRC=
CSP_EXTRA_FRAME_SRC=
CSP_EXTRA_IMG_SRC=

# ── Mock mode only (API_MODE=mock, APP_ENV=development|test) ─────────────────
# Local-only credentials for the in-memory mock backend. Choose your own values; there are no defaults.
# They have no effect (and are ignored) when API_MODE=live.
MOCK_ADMIN_EMAIL=
MOCK_ADMIN_PASSWORD=
# Six digits accepted as the SMS OTP by the mock backend.
MOCK_OTP_CODE=
