# ─────────────────────────────────────────────────────────────────────────────
# ONE 2 1 EIGHT — environment variables (PLACEHOLDERS ONLY). Copy to `.env.local`; never commit real values.
# All variables are read on the SERVER. Nothing here is exposed to browsers.
# The app validates them at start-up (lib/env.ts) and tells you exactly which one is missing.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production  (default: production for production builds, else development)
APP_ENV=development
# Public origin of this site (canonical URLs, sitemap, emails). Must be https and a real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# supabase → built-in backend on Supabase (default).  live → proxy to an external REST API at API_BASE_URL.
API_MODE=supabase

# ── Supabase: Dashboard → Project Settings → API (and API Keys) ──────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-only secret ("service_role" / secret key). NEVER put it in a NEXT_PUBLIC_ variable or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# "anon" / publishable key. Used only server-side to check admin passwords through Supabase Auth.
SUPABASE_ANON_KEY=

# Admin session cookie name (HttpOnly). Default is fine.
ADMIN_SESSION_COOKIE=o218_admin_session
# Swagger UI at /docs and the OpenAPI JSON. On by default outside production; set true to expose it in production.
ENABLE_API_DOCS=

# ── Email via Resend (optional until you are ready) ──────────────────────────
# Without these, orders and leads still save; emails are recorded as "skipped_unconfigured".
RESEND_API_KEY=
# The sender must be on a domain verified in Resend (see docs/EMAIL_SETUP.md). Planned: orders@send.one21eight.com
EMAIL_FROM=ONE 2 1 EIGHT <orders@send.one21eight.com>
INTERNAL_NOTIFICATION_EMAIL=
# Signing secret of the Resend webhook (whsec_...) for delivery tracking.
RESEND_WEBHOOK_SECRET=

# ── Online payments via Razorpay (optional; without them only Cash on delivery is offered) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Customer sign-in by SMS via MSG91 (required for customer sign-in; checkout needs a signed-in customer, so without it nobody can place an order) ──
# MSG91 OTP Widget (Web SDK, custom UI). MSG91_WIDGET_ID and MSG91_WIDGET_TOKEN_AUTH are the `widgetId` and `tokenAuth` values from the widget's generated code
# (NOT its name or the token's display label). MSG91_AUTH_KEY is the dedicated server-side Authkey: server-only, never NEXT_PUBLIC_. Set all three or none.
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN_AUTH=

# Backend timeout for external-API mode (ms).
API_TIMEOUT_MS=8000
# Shared secret for POST /api/revalidate (min 24 chars). Leave empty to disable.
REVALIDATE_SECRET=

# Extra Content-Security-Policy origins (space-separated). Razorpay is added automatically when its keys are set.
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_CONNECT_SRC=
CSP_EXTRA_FRAME_SRC=
CSP_EXTRA_IMG_SRC=

# --- E-mail provider ---
# resend (default and the only external provider) or mailpit (LOCAL testing only; refused when APP_ENV=production).
# Put real values only in the server's private configuration, never in Git.
# Where customer replies go (the visible sender is EMAIL_FROM).
# EMAIL_REPLY_TO=one21eight@gmail.com
# Min 24 characters. Protects POST /api/internal/email-retry (VPS cron, every 5 minutes).
# EMAIL_RETRY_SECRET=
# Local Mailpit testing:
# Mailpit: `docker compose up -d mailpit`, inbox http://localhost:8025. Inside docker compose SMTP_HOST is set to `mailpit` automatically.
EMAIL_PROVIDER=resend
# SMTP_HOST=localhost
# SMTP_PORT=1025

# ── Client IP for rate limiting (required in production) ──
# none (default): no forwarding header is trusted; all IP-limited requests share ONE bucket (limits stay on, they just cannot tell clients apart).
# cloudflare: use CF-Connecting-IP, but only for requests that also carry the header X-O218-Origin-Secret with TRUSTED_PROXY_SECRET as its value.
# vercel: use the X-Forwarded-For that Vercel itself sets, only when the app runs on Vercel (VERCEL=1, set by the platform; do not set it yourself). Needs DNS pointing straight at
#   Vercel with no other proxy (e.g. Cloudflare orange cloud) in front; behind one, that header holds the proxy's address. Needs no secret.
# TRUSTED_PROXY_SECRET is used by cloudflare only, and is optional ONLY when APP_ENV=development (e.g. a quick tunnel, which cannot add headers). Min 24 characters; keep it server-only.
TRUSTED_PROXY=
TRUSTED_PROXY_SECRET=
